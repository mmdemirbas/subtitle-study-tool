{
  "manifest_version": 3,
  "name": "Subtitle Overlay",
  "version": "0.1.0",
  "description": "Find a subtitle for whatever is playing and overlay it on the video, synced to the page's own playback clock.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "webNavigation",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8794/*",
    "https://api.opensubtitles.com/*",
    "https://*.opensubtitles.com/*",
    "https://*.opensubtitles.org/*"
  ],
  "optional_host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Subtitle Overlay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/align.js",
        "src/content.js",
        "src/panel.js",
        "src/study.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*"
      ],
      "js": [
        "src/sites/primevideo.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.netflix.com/*"
      ],
      "js": [
        "src/sites/netflix.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.tabii.com/*"
      ],
      "js": [
        "src/sites/survey.js",
        "src/sites/streams.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "src/sites/youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/chrome.css",
        "src/panel.css",
        "src/overlay.css",
        "src/study.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "auto-attach": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Find and attach the best subtitle for this tab"
    },
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Show or hide the subtitle overlay"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the control panel over the video"
    }
  }
}
